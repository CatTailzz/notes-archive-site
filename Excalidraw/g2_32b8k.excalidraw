    {
      "id": "lg",
      "type": "text",
      "x": 20,
      "y": 540,
      "width": 604,
      "height": 65,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 9897,
      "version": 1,
      "versionNonce": 9904,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "方框 = 一个 OoO task（内部是一串 op）。实线箭头 = 同核依赖，虚线 = 跨核依赖。\n配色：黄 cast/quant（含反量化）· 蓝 softmax · 红 mm · 紫 reduce · 绿 copy/assemble · 灰 其他\n⌛核空转 = 入依赖已就绪且本核也空着却没排上（已扣掉核占用）。注意它不一定在关键路径上，\n  要先看该核最后结束时刻离 makespan 还有多少 slack —— 被 slack 吸收的空转不值钱。",
      "originalText": "方框 = 一个 OoO task（内部是一串 op）。实线箭头 = 同核依赖，虚线 = 跨核依赖。\n配色：黄 cast/quant（含反量化）· 蓝 softmax · 红 mm · 紫 reduce · 绿 copy/assemble · 灰 其他\n⌛核空转 = 入依赖已就绪且本核也空着却没排上（已扣掉核占用）。注意它不一定在关键路径上，\n  要先看该核最后结束时刻离 makespan 还有多少 slack —— 被 slack 吸收的空转不值钱。",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    }
  ],
